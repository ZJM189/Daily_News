# Shared
APP_ENV=development
APP_DOMAIN=localhost

# Database
POSTGRES_DB=daily_news
POSTGRES_USER=daily_news
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://daily_news:change-me@postgres:5432/daily_news

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SESSION_SECRET=change-me-session-secret
CSRF_SECRET=change-me-csrf-secret
ENCRYPTION_KEY=change-me-32-byte-key

# Web
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Comma-separated origins for direct Next.js dev-server preview, for example:
# NEXT_ALLOWED_DEV_ORIGINS=example.com,101.251.179.93
NEXT_ALLOWED_DEV_ORIGINS=

# Scheduler
DEFAULT_TIMEZONE=Asia/Shanghai
DIGEST_CRON=0 8 * * *
