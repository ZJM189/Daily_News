# Shared
APP_ENV=development
APP_DOMAIN=localhost
APP_EXTERNAL_URL=http://localhost

# CORS is only needed when API and Web are served from different origins.
# For same-origin Caddy deployment, leave it empty.
CORS_ALLOWED_ORIGINS=

# Database
POSTGRES_DB=daily_news
POSTGRES_USER=daily_news
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://daily_news:change-me@postgres:5432/daily_news

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SESSION_SECRET=change-me-session-secret
SESSION_COOKIE_NAME=daily_news_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
CSRF_SECRET=change-me-csrf-secret
ENCRYPTION_KEY=change-me-32-byte-key

# Web
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Comma-separated origins for direct Next.js dev-server preview, for example:
# NEXT_ALLOWED_DEV_ORIGINS=example.com,101.251.179.93
NEXT_ALLOWED_DEV_ORIGINS=

# Caddy
# Local default:
CADDYFILE_PATH=./infra/caddy/Caddyfile
HTTP_PORT=80
# Production HTTPS:
# CADDYFILE_PATH=./infra/caddy/Caddyfile.production
# Optional. Caddy can request certificates without it, but an email helps ACME notices.
CADDY_ACME_EMAIL=

# Scheduler
DEFAULT_TIMEZONE=Asia/Shanghai
DIGEST_CRON=0 8 * * *
WORKER_POLL_INTERVAL_SECONDS=5

# External data source tokens. Empty means the related collector only uses public access
# or should be configured with an admin-managed credential in the Web console.
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
PRODUCT_HUNT_TOKEN=

# Optional default LLM seed values. Providers can also be managed in /admin/llm.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
